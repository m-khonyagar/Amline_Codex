# =============================================================================
# Amline Monorepo — Root .gitignore
# =============================================================================

# ---- Secrets & environment files ----
.env
.env.local
.env.*.local
*.env.local
# Keep .env.example files tracked

# ---- Python ----
__pycache__/
*.py[cod]
*.pyc
*.pyo
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml

# ---- Node.js / JS / TS ----
node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
.next/
*.tsbuildinfo

# ---- Build outputs ----
dist/
build/
out/
.cache/

# ---- IDE / Editor ----
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ---- Logs ----
*.log
logs/
run_*.log
uv_*.log

# ---- Agent workspace / ephemeral ----
workspace/
archives/
Task/

# ---- Playwright / Test artifacts ----
playwright-report/
test-results/
*.trace.zip

# ---- Misc ----
*.bak
*.tmp
dash_snap.json
dash_layout_check.txt
production_tables.json

# Prevent future local runtime bundles and disposable archives from re-entering git
**/portable_runtime/
*.zip
*.rar
