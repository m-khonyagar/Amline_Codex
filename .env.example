# =============================================================================
# Amline Monorepo — Root .env.example
# Copy to .env and fill in real values (never commit .env)
# =============================================================================

# ==================== General ====================
APP_ENV=development
APP_DEBUG=true
APP_NAME=Amline
APP_VERSION=1.0.0

# ==================== Security ====================
SECRET_KEY=change-me-min-32-chars-use-openssl-rand-hex-32
JWT_SECRET=change-me-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE=3600
JWT_REFRESH_EXPIRE=86400

# ==================== Database ====================
POSTGRES_USER=amline
POSTGRES_PASSWORD=change-me
POSTGRES_DB=amline
DATABASE_URL=postgresql://amline:change-me@localhost:5432/amline

# ==================== Redis ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me

# ==================== MinIO (Object Storage) ====================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=amline
MINIO_SECRET_KEY=change-me
MINIO_PUBLIC_BUCKET=public
MINIO_PRIVATE_BUCKET=private

# ==================== SMS Providers ====================
KAVENEGAR_API_KEY=your-kavenegar-api-key
TSMS_USERNAME=your-tsms-username
TSMS_PASSWORD=your-tsms-password
TSMS_SENDER_NUMBER=your-sender-number

# ==================== Bank Gateways ====================
ZARINPAL_TOKEN=your-zarinpal-token
PARSIAN_TOKEN=your-parsian-token

# ==================== Messaging Bots ====================
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
EITAA_BOT_TOKEN=your-eitaa-bot-token
BALE_CLIENT_ID=your-bale-client-id
BALE_CLIENT_SECRET=your-bale-client-secret

# ==================== AI / Agent Service ====================
OPENAI_API_KEY=your-openai-api-key
WORKSPACE_ROOT=./workspace
ALLOW_LOCAL_WRITE=false
ALLOW_SCRIPT_EXECUTION=false

# ==================== Deployment Servers ====================
# (Used only by deployment scripts — never put real values in this file)
SERVER_HOST=your-server-ip
SERVER_USER=root
SERVER_PASSWORD=your-server-password

# ==================== External APIs ====================
KENAR_DIVAR_API_KEY=your-kenar-divar-api-key
GSC_KEY_FILE=/path/to/service-account-key.json
GSC_SHEET_ID=

# ==================== Monitoring ====================
SENTRY_DSN=
